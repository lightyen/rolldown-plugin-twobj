{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "jsx": "preserve",
    "lib": ["esnext"],
    "types": ["node", "./types/emotion.d.ts"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "declaration": true
  }
}
